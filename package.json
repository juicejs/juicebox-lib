{
  "name": "juicebar",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve playground",
    "start:stoked": "ng serve playground --configuration stoked",
    "build": "ng build juicebar --configuration production && npm run build:schematics",
    "build:schematics": "tsc -p projects/juicebar/tsconfig.schematics.json && node projects/juicebar/scripts/copy-schematic-files.mjs",
    "publish:lib": "npm run build && npm publish dist/juicebar"
  },
  "schematics": "./schematics/collection.json",
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "moment": "^2.30.1",
    "randexp": "^0.5.3",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.4.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.2.5",
    "ngx-image-cropper": "9.1.5",
    "typescript": "~6.0.3"
  }
}
