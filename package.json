{
  "name": "juicebar",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve playground",
    "start:stoked": "ng serve playground --configuration stoked",
    "build": "ng build juicebar --configuration production && npm run build:schematics",
    "build:schematics": "tsc -p projects/juicebar/tsconfig.schematics.json && node projects/juicebar/scripts/copy-schematic-files.mjs",
    "publish:lib": "npm run build && npm publish dist/juicebar"
  },
  "schematics": "./schematics/collection.json",
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@kolkov/angular-editor": "~3.4.0",
    "moment": "^2.30.1",
    "randexp": "^0.5.3",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.4.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.5",
    "ngx-image-cropper": "9.1.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
