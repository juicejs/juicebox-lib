{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/juicebar",
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": ["src/lib"]
  },
  "allowedNonPeerDependencies": ["moment", "ngx-image-cropper", "randexp", "socket.io-client"],
  "assets": [
    { "input": "src/lib/assets", "glob": "**/*", "output": "assets" },
    { "input": "src/lib", "glob": "styles.scss", "output": "." }
  ]
}
